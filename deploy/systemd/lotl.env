# /etc/lotl/lotl.env - environment for lotl.service.
#
# Install with mode 0600 root:root (systemd reads it as root before the
# service starts; the service user never needs to read it). It may hold
# LOTL_ADMIN_PASSWORD, so NEVER commit a filled-in copy to version control.
#
# Precedence (cmd/lotl-server/main.go parseFlags):
#   command-line flag > LOTL_* environment variable > YAML file > default

# YAML configuration file (all settings; see deploy/config/lotl.yaml).
# It is read once at start-up, BEFORE the sandbox is applied, so it may live
# outside the data directory - but the service user must be able to read it.
# With DynamicUser=yes either make it world-readable (0644, no secrets in it)
# or hand it over as a credential (add to the unit:
#   LoadCredential=lotl.yaml:/etc/lotl/lotl.yaml
# ) and point here at the credentials directory:
#LOTL_CONFIG=/etc/lotl/lotl.yaml
#LOTL_CONFIG=/run/credentials/lotl.service/lotl.yaml

# Password for accounts.bootstrapAdmin (YAML). Only used when that account
# does not exist yet; remove it from this file after the first start.
# Prefer a systemd credential over a plain variable where possible, e.g. a
# separate 0600 EnvironmentFile= that only holds this line.
#LOTL_ADMIN_PASSWORD=change-me-to-a-long-random-passphrase

# Listen address host:port. Ignored when started by lotl.socket.
# Default: 127.0.0.1:8080
#LOTL_LISTEN=0.0.0.0:8080

# Port only; replaces the port part of LOTL_LISTEN (0 = keep it).
# Ignored when started by lotl.socket.
#LOTL_PORT=8080

# Data directory. The unit pins it to the StateDirectory (/var/lib/lotl)
# with -data, which also overrides data.dir from the YAML file.
#LOTL_DATA=/var/lib/lotl

# TLS: both must be set; enables HTTPS, Secure cookies and HSTS.
# The files are read before the sandbox is applied. Put them in /etc/lotl
# (readable by the service) or use LoadCredential= in the unit.
#LOTL_TLS_CERT=/etc/lotl/tls.crt
#LOTL_TLS_KEY=/etc/lotl/tls.key

# Log level: debug | info | warn | error (default info).
#LOTL_LOG_LEVEL=info

# Flags without an environment variable, passed verbatim on the command
# line by the unit (word-split, no shell quoting). Each has a YAML key too.
#   -secure-cookies        Secure cookie + HSTS (server.secureCookies)
#   -trust-proxy           honour X-Forwarded-For (server.trustProxy; proxy on loopback only!)
#   -allow-origin a,b      extra Origin hosts (server.allowedOrigins)
#   -max-rooms N           concurrent rooms (server.maxRooms, default 200)
#   -no-sandbox            disable in-process hardening (security.sandbox; debugging only)
#   -config FILE           same as LOTL_CONFIG
#LOTL_OPTS=-secure-cookies -trust-proxy -max-rooms 200
